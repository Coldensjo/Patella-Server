# Runtime output written by the game server
log/*
!log/.gitkeep
save/*
!save/.gitkeep

# REA / analysis scratch output
rea-out/

# Documentation stays local; commit messages carry the explanation
*.md
*.markdown
*.rst
*.adoc
*.txt
!CMakeLists.txt
*.pdf
*.doc
*.docx
doc/
docs/
notes/

# RSA keys stay local: key files (key.pem, made with keygen/rsakeygen) and
# the old header format of CipSoft's key
*.pem
src/RSA_PrivateKey.hh
!README.md
__pycache__/
