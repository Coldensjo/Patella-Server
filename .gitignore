# Runtime output written by the game server
log/*
!log/.gitkeep
save/*
!save/.gitkeep

# REA / analysis scratch output
rea-out/

# Documentation stays local; commit messages carry the explanation
*.md
*.markdown
*.rst
*.adoc
*.txt
!CMakeLists.txt
*.pdf
*.doc
*.docx
doc/
docs/
notes/

# The RSA key stays local; without it the build generates one (keygen/)
src/RSA_PrivateKey.hh
!README.md
